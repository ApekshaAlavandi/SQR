FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY run_tracked_clip.py ./

RUN pip install .

RUN useradd --create-home --uid 10001 scout
USER scout

ENTRYPOINT ["scout-ai-local"]
