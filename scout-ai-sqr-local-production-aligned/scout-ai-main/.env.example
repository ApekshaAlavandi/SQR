# Copy to `.env` for local mode. Every variable is optional; these are the defaults.

SCOUT_DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/scout
SCOUT_LOG_LEVEL=INFO

# "stub"   = offline canned AI output; no network, no key (default)
# "gemini" = real Gemini; set SCOUT_GEMINI_API_KEY (or SCOUT_GCP_PROJECT_ID + ADC)
SCOUT_AI_BACKEND=stub
# SCOUT_GEMINI_API_KEY=
# SCOUT_GEMINI_MODEL=gemini-3-flash-preview

# gs://<bucket>/<key> is read from <SCOUT_LOCAL_MEDIA_DIR>/<bucket>/<key>
SCOUT_LOCAL_MEDIA_DIR=./local_media

# Which clip-analysis prompt the draft flow uses:
#   evidence (default) = evidence-first prompt -> clip_reviews (as before) + clip_analyses & B-screen tables
#   legacy             = previous prompt, clip_reviews only (instant rollback)
SCOUT_ANALYSIS_MODE=evidence
